# Copy to .env if you want to change anything:  cp .env.example .env
# Everything has a working default, so this file is optional for the demo.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True

POSTGRES_DB=hookrelay
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay

# SSRF protection switch.
# True  = localhost / private IPs are ALLOWED (needed for the local mock receiver demo)
# False = they are BLOCKED (use this in production!)
HOOKRELAY_ALLOW_PRIVATE_URLS=True